<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bank.app.MainController"
            prefWidth="1150" prefHeight="760">

    <top>
        <VBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: #e8f5e9;">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label fx:id="titleLabel" text="Банковская система"/>
            <Label fx:id="userLabel"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="12" right="12" bottom="12" left="20"/>
            </padding>
            <HBox spacing="12" VBox.vgrow="ALWAYS">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Клиенты"/>
                    <TableView fx:id="clientTable" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Счета"/>
                    <TableView fx:id="accountTable" VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Label text="Транзакции"/>
                <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS"/>
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_LEFT" spacing="8" prefWidth="290" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>
            <Label fx:id="operationsLabel" text="Операции"/>

            <Label text="Со счёта:"/>
            <ComboBox fx:id="accountCombo" maxWidth="Infinity"/>
            <Label fx:id="balanceLabel"/>

            <Label text="На счёт (для перевода):"/>
            <ComboBox fx:id="targetCombo" maxWidth="Infinity"/>

            <Label text="Сумма:"/>
            <TextField fx:id="amountField"/>
            <Slider fx:id="amountSlider"/>
            <ProgressBar fx:id="shareBar" maxWidth="Infinity"/>

            <Button fx:id="depositButton" text="Пополнить" maxWidth="Infinity"/>
            <Button fx:id="withdrawButton" text="Снять" maxWidth="Infinity"/>
            <Button fx:id="transferButton" text="Перевести" maxWidth="Infinity"/>
            <Button fx:id="reportButton" text="Показать отчёт" maxWidth="Infinity"/>

            <Label fx:id="statusLabel" maxWidth="Infinity"/>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-background-color: #eeeeee;">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label fx:id="filterLabel" text="Фильтр транзакций:"/>
            <RadioButton fx:id="allRadio" text="Все"/>
            <RadioButton fx:id="depositRadio" text="Пополнения"/>
            <RadioButton fx:id="withdrawRadio" text="Снятия"/>
            <RadioButton fx:id="transferRadio" text="Переводы"/>
            <DatePicker fx:id="fromDate"/>
            <CheckBox fx:id="myOnlyCheck" text="Только мои данные"/>
        </HBox>
    </bottom>
</BorderPane>